# AAGMAN Maharashtra Tourism Platform - Environment Configuration Template
# Copy this file to .env and configure your production Supabase project credentials.

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous/Public API Key (safe for client-side use; never use service_role here)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
